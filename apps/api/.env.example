PORT=3001
# Production bind (default in NODE_ENV=production is 127.0.0.1)
# HOST=127.0.0.1

# PostgreSQL — never expose publicly. Local example uses port 8000 / edu_os.
# Production uses chora_db on the VPS (do not run migrations from this task).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:8000/edu_os?schema=public

# Docker (optional): docker compose -f infra/docker-compose.yml up -d
# DATABASE_URL=postgresql://edu_os_user:edu_os_pass@localhost:5432/edu_os?schema=public
JWT_SECRET=change-me
JWT_EXPIRY_SECONDS=3600
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRY_SECONDS=604800

# Optional: AES-256-GCM key material for EmployeeProfile bank account numbers at rest.
# When unset, values are stored as provided and still masked in read-only HR APIs.
# PAYROLL_BANK_ENCRYPTION_KEY=long-random-secret
DEFAULT_SCHOOL_ID=school-addis
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Fayeda / VeriFayda identity verification (mock for development)
FAYEDA_MODE=mock
FAYEDA_MOCK_OTP=123456
# Live integration (register at https://id.gov.et/api):
# FAYEDA_MODE=live
# FAYEDA_CLIENT_ID=
# FAYEDA_TOKEN_ENDPOINT=
# FAYEDA_USERINFO_ENDPOINT=

# Chapa live checkout is OFF by default (commercial license required).
# Parents pay by Telebirr or bank transfer; finance verifies.
# Set CHAPA_ENABLED=true only after you have a licensed Chapa merchant account.
WEB_APP_URL=http://localhost:3002
# Production:
# WEB_APP_URL=https://chora.awuddigitals.com
API_PUBLIC_URL=http://127.0.0.1:3001
# Production public API via nginx:
# API_PUBLIC_URL=https://chora.awuddigitals.com/backend

# Explicit runtime bootstrap is NEVER automatic. See docs/PRODUCTION_STARTUP_SAFETY.md
# CHORA_ALLOW_RUNTIME_BOOTSTRAP=1
# PLATFORM_OWNER_EMAIL=
# PLATFORM_OWNER_PASSWORD=

# Awud Digitals / Alet SMTP. Passwords stay in this server env file only.
# CHORA_EMAIL_ENABLED=false keeps delivery off until credentials are set.
# The queue worker starts only when CHORA_EMAIL_WORKER=true.
# Port 465 uses SSL/TLS. Port 587 is STARTTLS: set CHORA_SMTP_PORT=587 and CHORA_SMTP_SECURE=false.
# Legacy EMAIL_ENABLED, SMTP_HOST, SMTP_PORT, SMTP_USER, and SMTP_PASS are still read.
# SMTP_PASS is used only for the mailbox whose address equals SMTP_USER.
CHORA_EMAIL_ENABLED=false
CHORA_EMAIL_WORKER=false
CHORA_SMTP_HOST=mx1.aletcloud.com
CHORA_SMTP_PORT=465
CHORA_SMTP_SECURE=true
CHORA_CONTACT_EMAIL=contact@awuddigitals.com
CHORA_SUPPORT_EMAIL=support@awuddigitals.com
CHORA_ADMIN_EMAIL=admin@awuddigitals.com
CHORA_INFO_EMAIL=info@awuddigitals.com
CHORA_SALES_EMAIL=sales@awuddigitals.com
CHORA_CONTACT_EMAIL_PASSWORD=
CHORA_SUPPORT_EMAIL_PASSWORD=
CHORA_ADMIN_EMAIL_PASSWORD=
CHORA_INFO_EMAIL_PASSWORD=
CHORA_SALES_EMAIL_PASSWORD=

CHAPA_ENABLED=false
CHAPA_SECRET_KEY=CHASECK_TEST-your-secret-key
CHAPA_WEBHOOK_SECRET=your-webhook-secret-hash
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your-public-key

# AI (optional bootstrap). Prefer Platform console → Settings → AI (Gemini key).
# Env is used only when platform AI is disabled or has no key.
# Gemini OpenAI-compatible example:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.0-flash
#   AI_API_KEY=your-gemini-api-key
AI_BASE_URL=https://api.freemodel.dev/v1
AI_MODEL=claude-t0
AI_API_KEY=
