generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  staff
  teacher
  student
  parent
}

/// @deprecated Use RoleTemplate — kept for migration only.
enum SchoolStaffRole {
  SCHOOL_ADMIN
  VICE_PRINCIPAL
  FINANCE_OFFICER
  HOMEROOM_TEACHER
  SUBJECT_TEACHER
}

enum AttendanceMode {
  DAILY
  PERIOD
  BOTH
}

enum AttendanceStatus {
  present
  absent
  late
  excused
  medical
}

enum AttendanceReason {
  sick
  family_emergency
  unexcused
  other
}

enum AttendancePermissionType {
  ABSENCE
  LATE
  EARLY_LEAVE
  OTHER
}

enum AttendancePermissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Plan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum PlatformInvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum BillingCurrency {
  USD
  ETB
}

enum SchoolStatus {
  ACTIVE
  TRIAL
  SUSPENDED
}

enum PlatformRole {
  OWNER
  SUPPORT
  SALES
}

enum SchoolType {
  KINDERGARTEN
  PRIMARY
  SECONDARY
  PREPARATORY
  MIXED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GradePreset {
  GRADES_1_8
  GRADES_9_12
  KG_12
}

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  TERM
  ANNUAL
}

enum StudentFeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  SCHOLARSHIP
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  TELEBIRR
  CHAPA
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ResultWorkflowStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassworkType {
  WORKSHEET
  ASSIGNMENT
}

enum ClassworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ClassworkSubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

enum LibraryResourceType {
  BOOK_PDF
  EPUB
  DOCUMENT
  NOTES
  ASSIGNMENT
  LAB_MANUAL
  EXAM
  VIDEO
  AUDIO
  RESEARCH
  OTHER
}

enum LibraryResourceStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum LibraryAudience {
  STUDENTS
  TEACHERS
  BOTH
}

model School {
  id            String         @id
  name          String
  slug          String         @unique
  joinCode      String         @unique
  logoUrl       String?
  /// School principal / authorized signature image (URL or data URL) for ID cards & reports
  authorizedSignatureUrl String?
  /// Label under the signature (e.g. "Principal", "Director")
  authorizedSignatureLabel String?
  /// Main brand color (hex, e.g. #3d9b9b). Null = Chora default.
  primaryColor  String?
  /// Accent / highlight color (hex). Null = Chora default.
  accentColor   String?
  /// Darker brand accent for text and buttons (hex). Null = Chora default.
  accentDeep    String?
  schoolType    SchoolType?
  address       String?
  email         String?
  country       String?
  phone         String?
  /// Shown on report-card header (defaults to "Student Report Card")
  reportCardTitle   String?
  /// Optional motto / tagline under the school name on report cards
  reportCardTagline String?
  bankName              String?
  bankAccountHolder     String?
  bankAccountNumber     String?
  telebirrNumber        String?
  telebirrAccountName   String?
  paymentInstructions   String?
  gradePreset           GradePreset?
  curriculumPackageKey  String?
  attendanceMode        AttendanceMode @default(DAILY)
  setupComplete         Boolean        @default(false)
  status                SchoolStatus   @default(TRIAL)
  invites       SchoolInvite[]
  subscription  Subscription?
  grades         Grade[]
  academicYears  AcademicYear[]
  academicTerms  AcademicTerm[]
  subjects       Subject[]
  classSubjects  ClassSubject[]
  gradingScales         GradingScale[]
  assessmentTemplates   AssessmentTemplate[]
  timetables            Timetable[]
  examSchedules         ExamSchedule[]
  libraryCategories     LibraryCategory[]
  libraryResources      LibraryResource[]
  departments           SchoolDepartment[]
  messageTemplates      SchoolMessageTemplate[]
  provisioningLogs      SchoolProvisioningLog[]
  admissionCycles       AdmissionCycle[]
  admissionApplications AdmissionApplication[]
  admissionPlacementRules AdmissionPlacementRule[]
  feeTypes       FeeType[]
  feeSchedules   FeeSchedule[]
  roleTemplates  RoleTemplate[]
  platformInvoices PlatformInvoice[]
  platformPaymentProofs PlatformPaymentProof[]
  couponRedemptions CouponRedemption[]
  supportTickets   SupportTicket[]
  scoreCorrections ScoreCorrectionRequest[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model PermissionDefinition {
  key         String   @id
  label       String
  category    String
  description String?
  templates   RoleTemplatePermission[]
}

model RoleTemplate {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String?
  portalRole  UserRole
  isSystem    Boolean  @default(true)
  permissions RoleTemplatePermission[]
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, slug])
  @@index([schoolId])
}

model RoleTemplatePermission {
  roleTemplateId String
  permissionKey  String
  roleTemplate   RoleTemplate         @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)
  permission     PermissionDefinition @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleTemplateId, permissionKey])
}

model UserPermissionGrant {
  userId        String
  permissionKey String
  granted       Boolean @default(true)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionKey])
}

model Subscription {
  id               String    @id @default(cuid())
  schoolId         String    @unique
  school           School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan             Plan      @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  couponCode       String?
  isActive         Boolean   @default(true)
  /// Billable module keys enabled for this school (JSON string[]). Empty = grandfather all.
  enabledModules   Json      @default("[]")
  /// Optional bundle preset: ops | school | full
  billingBundle    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([plan, isActive])
}

enum CouponKind {
  PERCENT_OFF
  EXTRA_TRIAL_DAYS
  COMPLIMENTARY
}

model Coupon {
  id                  String             @id @default(cuid())
  code                String             @unique
  kind                CouponKind
  percentOff          Int                @default(0)
  extraDays           Int                @default(0)
  complimentaryMonths Int                @default(1)
  plan                Plan?
  maxRedemptions      Int?
  redeemedCount       Int                @default(0)
  expiresAt           DateTime?
  isActive            Boolean            @default(true)
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  redemptions         CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  appliedBy String?
  result    String?
  createdAt DateTime @default(now())

  @@unique([couponId, schoolId])
  @@index([schoolId])
}

/// Platform-managed sellable plans (prices, limits, copy)
model PlanCatalog {
  plan          Plan     @id
  label         String
  description   String   @db.Text
  studentsLimit Int?
  teachersLimit Int?
  adminsLimit   Int?
  usdMonthly    Int      @default(0)
  etbMonthly    Int      @default(0)
  features      Json     @default("[]")
  trialDays     Int?
  sortOrder     Int      @default(0)
  isListed      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Platform billing invoices issued to schools
model PlatformInvoice {
  id            String                @id @default(cuid())
  schoolId      String
  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invoiceNumber String                @unique
  plan          Plan?
  periodStart   DateTime
  periodEnd     DateTime
  amountUsd     Int                   @default(0)
  amountEtb     Int                   @default(0)
  currency      BillingCurrency       @default(USD)
  status        PlatformInvoiceStatus @default(DRAFT)
  issuedAt      DateTime              @default(now())
  dueAt         DateTime
  paidAt            DateTime?
  notes             String?               @db.Text
  paymentReference  String?               @unique
  billingInterval   String?
  initiatedBy       String?
  /// Snapshot of modules selected at invoice time (JSON string[])
  enabledModules    Json?
  billingBundle     String?
  paymentProofs     PlatformPaymentProof[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([schoolId])
  @@index([status])
  @@index([dueAt])
}

enum PlatformPayMethod {
  TELEBIRR
  BANK_TRANSFER
}

enum PlatformPaymentProofStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// School admin submits Telebirr/bank proof against a platform invoice
model PlatformPaymentProof {
  id            String                     @id @default(cuid())
  invoiceId     String
  invoice       PlatformInvoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  schoolId      String
  school        School                     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  method        PlatformPayMethod
  transactionId String
  proofUrl      String                     @db.Text
  status        PlatformPaymentProofStatus @default(PENDING)
  submittedById String?
  reviewNote    String?                    @db.Text
  reviewedAt    DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([invoiceId, status])
  @@index([schoolId, status])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_SCHOOL
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  BILLING
  TECHNICAL
  ONBOARDING
  ACCOUNT
  OTHER
}

/// School admin issues reported to the platform control center
model SupportTicket {
  id           String                @id @default(cuid())
  schoolId     String
  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User                  @relation("SupportTicketsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  subject      String
  body         String                @db.Text
  category     SupportTicketCategory @default(OTHER)
  status       SupportTicketStatus   @default(OPEN)
  platformNote String?               @db.Text
  resolvedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([schoolId, status, createdAt])
  @@index([status, createdAt])
}

model SchoolInvite {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  token     String    @unique
  role      UserRole
  label     String?
  expiresAt DateTime?
  maxUses   Int?
  useCount  Int       @default(0)
  createdBy String
  createdAt DateTime  @default(now())

  @@index([schoolId])
}

model Grade {
  id        String           @id @default(cuid())
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int
  sections              Section[]
  students              StudentProfile[]
  feeSchedules          FeeSchedule[]
  classSubjects         ClassSubject[]
  teacherAssignments    TeacherAssignment[]
  homeroomTeachers           TeacherProfile[]    @relation("TeacherHomeroomGrade")
  studentEnrollments         StudentEnrollment[]
  assessmentTemplateGrades   AssessmentTemplateGrade[]
  timetableEntries           TimetableEntry[]
  libraryResources           LibraryResource[]
  admissionTargetGrades      AdmissionApplication[]    @relation("ApplicationTargetGrade")
  admissionPlacedGrades      AdmissionApplication[]    @relation("ApplicationPlacedGrade")
  admissionPlacementRules      AdmissionPlacementRule[]
  examScheduleSlots            ExamScheduleSlot[]

  @@unique([schoolId, name])
  @@index([schoolId, sortOrder])
}

model Section {
  id            String           @id @default(cuid())
  gradeId       String
  grade         Grade            @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  name          String
  students              StudentProfile[]
  classSubjects         ClassSubject[]
  teacherAssignments    TeacherAssignment[]
  homeroomTeachers      TeacherProfile[]    @relation("TeacherHomeroomSection")
  studentEnrollments    StudentEnrollment[]
  timetableEntries      TimetableEntry[]
  admissionPlacements   AdmissionApplication[]
  admissionPlacementRules AdmissionPlacementRule[]

  @@unique([gradeId, name])
}

model User {
  id              String              @id
  schoolId        String
  role            UserRole
  staffRole       SchoolStaffRole?
  roleTemplateId  String?
  roleTemplate    RoleTemplate?       @relation(fields: [roleTemplateId], references: [id], onDelete: SetNull)
  permissionGrants UserPermissionGrant[]
  username        String
  email           String              @unique
  phone           String?
  firstName       String
  lastName        String
  externalRef     String?
  passwordHash    String
  studentProfile  StudentProfile?
  teacherProfile  TeacherProfile?
  parentLinks          ParentStudent[]      @relation("ParentUser")
  parentNotifications  ParentNotification[] @relation("ParentNotifications")
  attendanceMarks      AttendanceRecord[]   @relation("AttendanceMarkedBy")
  paymentsRecorded     Payment[]            @relation("PaymentsRecordedBy")
  resultsUpdated       ResultRecord[]       @relation("ResultUpdatedBy")
  resultSheetsSubmitted ClassSubjectTermSheet[] @relation("ResultSheetSubmittedBy")
  resultSheetsApproved  ClassSubjectTermSheet[] @relation("ResultSheetApprovedBy")
  resultSheetsPublished ClassSubjectTermSheet[] @relation("ResultSheetPublishedBy")
  classSubjectsTaught  ClassSubject[]       @relation("ClassSubjectTeacher")
  timetableEntries     TimetableEntry[]     @relation("TimetableEntryTeacher")
  announcements   Announcement[]      @relation("AnnouncementCreatedBy")
  announcementInbox Announcement[]    @relation("AnnouncementRecipient")
  reads           AnnouncementRead[]
  libraryUploads  LibraryResource[]   @relation("LibraryUploadedBy")
  studentDocumentsUploaded StudentDocument[] @relation("StudentDocumentUploadedBy")
  behaviorRecordsRecorded  BehaviorRecord[]  @relation("BehaviorRecordedBy")
  certificatesIssued       StudentCertificate[] @relation("CertificateIssuedBy")
  classworkCreated         ClassworkAssignment[] @relation("ClassworkCreatedBy")
  classworkGraded          ClassworkSubmission[] @relation("ClassworkGradedBy")
  attendancePermissionsRequested AttendancePermissionRequest[] @relation("AttendancePermissionRequester")
  attendancePermissionsReviewed  AttendancePermissionRequest[] @relation("AttendancePermissionReviewer")
  supportTicketsCreated          SupportTicket[]               @relation("SupportTicketsCreated")
  scoreCorrectionsReported       ScoreCorrectionRequest[]      @relation("ScoreCorrectionReporter")
  scoreCorrectionsAssigned       ScoreCorrectionRequest[]      @relation("ScoreCorrectionTeacher")
  scoreCorrectionsReviewed       ScoreCorrectionRequest[]      @relation("ScoreCorrectionReviewer")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([schoolId, username])
  @@index([schoolId, role])
  @@index([schoolId, staffRole])
  @@index([phone])
}

enum AdmissionStatus {
  APPLIED
  SCORED
  PLACED
  ACCEPTED
  REJECTED
  ENROLLED
  WITHDRAWN
}

enum StudentRecordStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
}

enum PromotionOutcome {
  ENROLLED
  PASSED
  PROMOTED
  RETAINED
  GRADUATED
}

enum StudentDocumentType {
  BIRTH_CERTIFICATE
  NATIONAL_ID
  PASSPORT
  TRANSFER_LETTER
  RECOMMENDATION_LETTER
  MEDICAL
  PHOTO
  OTHER
}

enum BehaviorRecordType {
  LATE_ARRIVAL
  ABSENT_WITHOUT_REASON
  DISRUPTIVE
  EXCELLENT_CONDUCT
  WARNING
  SUSPENSION
  OTHER
}

enum StudentCertificateType {
  ENROLLMENT
  COMPLETION
  GRADUATION
  CONDUCT
}

model StudentProfile {
  id                 String               @id @default(cuid())
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId           String
  gradeId            String
  grade              Grade                @relation(fields: [gradeId], references: [id])
  sectionId          String?
  section            Section?             @relation(fields: [sectionId], references: [id])
  status             StudentRecordStatus  @default(ACTIVE)
  graduatedAt        DateTime?
  gender             Gender?
  middleName         String?
  dateOfBirth        DateTime?
  photoUrl           String?
  fan                String?
  fcn                String?
  nationality        String?
  region             String?
  zone               String?
  woreda             String?
  address            String?              @db.Text
  phone              String?
  fayedaVerifiedAt   DateTime?
  cardCode           String?
  /// Shown to admins while student has not changed their portal password.
  portalTempPassword String?
  /// When false, linked parents cannot view results or report cards.
  parentsCanViewResults Boolean @default(true)
  parents            ParentStudent[]
  admissionApplication AdmissionApplication?
  attendanceRecords  AttendanceRecord[]
  parentNotifications ParentNotification[]
  studentFees         StudentFee[]
  payments            Payment[]
  assessmentScores    StudentAssessmentScore[]
  termReports         StudentTermReport[]
  enrollments         StudentEnrollment[]
  libraryFavorites    LibraryFavorite[]
  libraryProgress     LibraryReadingProgress[]
  documents           StudentDocument[]
  behaviorRecords     BehaviorRecord[]
  healthRecord        StudentHealthRecord?
  certificates        StudentCertificate[]
  classworkSubmissions ClassworkSubmission[]
  attendancePermissionRequests AttendancePermissionRequest[]
  examSeatingAssignments ExamSeatingAssignment[]
  scoreCorrections       ScoreCorrectionRequest[]

  @@unique([schoolId, fan])
  @@unique([schoolId, fcn])
  @@unique([schoolId, cardCode])
  @@index([schoolId, gradeId])
  @@index([sectionId])
}

model ParentStudent {
  id        String         @id @default(cuid())
  parentId  String
  parent    User           @relation("ParentUser", fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model AttendanceRecord {
  id               String            @id @default(cuid())
  schoolId         String
  studentProfileId String
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  date             DateTime          @db.Date
  periodNumber     Int               @default(0)
  subject          String?
  status           AttendanceStatus
  reason           AttendanceReason?
  recordedBy       String
  marker           User              @relation("AttendanceMarkedBy", fields: [recordedBy], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([schoolId, studentProfileId, date, periodNumber])
  @@index([schoolId, date])
  @@index([studentProfileId, date])
}

model AttendancePermissionRequest {
  id                String                     @id @default(cuid())
  schoolId          String
  studentProfileId  String
  studentProfile    StudentProfile             @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  requestedByUserId String
  requester         User                       @relation("AttendancePermissionRequester", fields: [requestedByUserId], references: [id])
  type              AttendancePermissionType
  date              DateTime                   @db.Date
  reason            AttendanceReason?
  note              String?                    @db.Text
  status            AttendancePermissionStatus @default(PENDING)
  reviewedByUserId  String?
  reviewer          User?                      @relation("AttendancePermissionReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  reviewNote        String?                    @db.Text
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([schoolId, status, date])
  @@index([studentProfileId, date])
}

model ParentNotification {
  id               String         @id @default(cuid())
  schoolId         String
  parentId         String
  parent           User           @relation("ParentNotifications", fields: [parentId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  title            String
  body             String
  readAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([parentId, readAt])
  @@index([schoolId, createdAt])
}

model ResultRecord {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  subject   String
  score     Int
  updatedBy String
  updater   User     @relation("ResultUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([schoolId, studentId, subject])
  @@index([schoolId, studentId])
}

model AcademicTerm {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int          @default(0)
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  isCurrent      Boolean      @default(false)
  assessments    Assessment[]
  resultSheets        ClassSubjectTermSheet[]
  studentTermReports  StudentTermReport[]
  examSchedules       ExamSchedule[]
  scoreCorrections    ScoreCorrectionRequest[]

  @@unique([academicYearId, name])
  @@index([schoolId, isCurrent])
}

model Subject {
  id                 String           @id @default(cuid())
  schoolId           String
  school             School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name               String
  code               String
  isSystem           Boolean          @default(false)
  platformSubjectId  String?
  platformSubject    PlatformSubject? @relation(fields: [platformSubjectId], references: [id], onDelete: SetNull)
  isCustomized       Boolean          @default(false)
  classSubjects              ClassSubject[]
  teacherAssignments         TeacherAssignment[]
  assessmentTemplateGrades   AssessmentTemplateGrade[]
  timetableEntries           TimetableEntry[]
  examScheduleSlots          ExamScheduleSlot[]

  @@unique([schoolId, code])
  @@index([platformSubjectId])
}

model ClassSubject {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeId        String
  grade          Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  sectionId      String?
  section        Section?     @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  teacherId      String?
  teacher              User?                @relation("ClassSubjectTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  weeklySessions       Int                  @default(1)
  assessments          Assessment[]
  assessmentTemplateId String?
  assessmentTemplate   AssessmentTemplate?  @relation(fields: [assessmentTemplateId], references: [id], onDelete: SetNull)
  termSheets           ClassSubjectTermSheet[]
  classworkAssignments ClassworkAssignment[]
  scoreCorrections     ScoreCorrectionRequest[]

  @@unique([schoolId, subjectId, gradeId, sectionId, academicYearId])
  @@index([schoolId, gradeId])
}

model ClassSubjectTermSheet {
  id             String               @id @default(cuid())
  schoolId       String
  termId         String
  term           AcademicTerm         @relation(fields: [termId], references: [id], onDelete: Cascade)
  classSubjectId String
  classSubject   ClassSubject         @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  status         ResultWorkflowStatus @default(DRAFT)
  submittedBy    String?
  submitter      User?                @relation("ResultSheetSubmittedBy", fields: [submittedBy], references: [id], onDelete: SetNull)
  submittedAt    DateTime?
  approvedBy     String?
  approver       User?                @relation("ResultSheetApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  publishedBy    String?
  publisher      User?                @relation("ResultSheetPublishedBy", fields: [publishedBy], references: [id], onDelete: SetNull)
  publishedAt    DateTime?
  reviewerNotes  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([termId, classSubjectId])
  @@index([schoolId, status])
}

model StudentTermReport {
  id               String         @id @default(cuid())
  schoolId         String
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  termId           String
  term             AcademicTerm   @relation(fields: [termId], references: [id], onDelete: Cascade)
  teacherComment   String?
  principalComment String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentProfileId, termId])
  @@index([schoolId, termId])
}

model AssessmentTemplate {
  id                           String                      @id @default(cuid())
  schoolId                     String
  school                       School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                         String
  description                  String?
  isDefault                    Boolean                     @default(false)
  isSystem                     Boolean                     @default(false)
  platformAssessmentTemplateId String?
  platformAssessmentTemplate   PlatformAssessmentTemplate? @relation(fields: [platformAssessmentTemplateId], references: [id], onDelete: SetNull)
  isCustomized                 Boolean                     @default(false)
  components                   AssessmentTemplateComponent[]
  gradeLinks                   AssessmentTemplateGrade[]
  classSubjects                ClassSubject[]
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([platformAssessmentTemplateId])
}

model AssessmentTemplateComponent {
  id            String             @id @default(cuid())
  templateId    String
  template      AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name          String
  weightPercent Int
  maxScore      Int                @default(100)
  sortOrder     Int                @default(0)

  @@unique([templateId, name])
}

model AssessmentTemplateGrade {
  id         String             @id @default(cuid())
  templateId String
  template   AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  gradeId    String
  grade      Grade              @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subjectId  String?
  subject    Subject?           @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([templateId, gradeId, subjectId])
  @@index([gradeId, subjectId])
}

model Assessment {
  id             String                   @id @default(cuid())
  schoolId       String
  termId         String
  term           AcademicTerm             @relation(fields: [termId], references: [id], onDelete: Cascade)
  classSubjectId String
  classSubject   ClassSubject             @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  name           String
  maxScore       Int                      @default(100)
  weightPercent  Int                      @default(100)
  sortOrder      Int                      @default(0)
  /// When true, teachers cannot enter or edit scores for this component.
  entryLocked    Boolean                  @default(false)
  scores         StudentAssessmentScore[]
  scoreCorrections ScoreCorrectionRequest[]

  @@unique([termId, classSubjectId, name])
  @@index([schoolId, termId])
}

enum ScoreCorrectionStatus {
  OPEN
  PROPOSED
  APPROVED
  REJECTED
}

/// Post-publish score dispute: report → teacher propose → admin approve/reject
model ScoreCorrectionRequest {
  id               String                @id @default(cuid())
  schoolId         String
  school           School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId           String
  term             AcademicTerm          @relation(fields: [termId], references: [id], onDelete: Cascade)
  classSubjectId   String
  classSubject     ClassSubject          @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  assessmentId     String
  assessment       Assessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile        @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  reportedById     String
  reportedBy       User                  @relation("ScoreCorrectionReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  teacherId        String?
  teacher          User?                 @relation("ScoreCorrectionTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  message          String                @db.Text
  currentScore     Int?
  proposedScore    Int?
  status           ScoreCorrectionStatus @default(OPEN)
  reviewedById     String?
  reviewedBy       User?                 @relation("ScoreCorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNote       String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([schoolId, status, createdAt])
  @@index([teacherId, status])
  @@index([studentProfileId, status])
  @@index([assessmentId, studentProfileId])
}

model StudentAssessmentScore {
  id               String         @id @default(cuid())
  assessmentId     String
  assessment       Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  score            Int
  updatedAt        DateTime       @updatedAt

  @@unique([assessmentId, studentProfileId])
  @@index([studentProfileId])
}

model GradingScale {
  id        String        @id @default(cuid())
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String        @default("Default")
  isDefault Boolean       @default(true)
  bands     GradingBand[]
}

model GradingBand {
  id       String       @id @default(cuid())
  scaleId  String
  scale    GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)
  letter   String
  minScore Int
  maxScore Int

  @@index([scaleId])
}

model Announcement {
  id              String             @id @default(cuid())
  schoolId        String
  title           String
  body            String
  createdBy       String
  creator         User               @relation("AnnouncementCreatedBy", fields: [createdBy], references: [id])
  /// When set, only this user sees the item in their notification inbox.
  recipientUserId String?
  recipient       User?              @relation("AnnouncementRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  reads           AnnouncementRead[]
  createdAt       DateTime           @default(now())

  @@index([schoolId, createdAt])
  @@index([recipientUserId, createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

model PlatformUser {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            PlatformRole @default(OWNER)
  isActive        Boolean      @default(true)
  lastLoginAt     DateTime?
  inviteToken     String?      @unique
  inviteExpiresAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model PlatformAuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String
  action      String
  targetId    String?
  targetEmail String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model PlatformSettings {
  id                    String           @id @default("default")
  platformName          String           @default("Chora")
  supportEmail          String?
  supportPhone          String?
  defaultCountry        String           @default("Ethiopia")
  defaultTimezone       String           @default("Africa/Addis_Ababa")
  allowSelfRegistration Boolean          @default(true)
  requireAdminApproval  Boolean          @default(false)
  defaultTrialDays      Int              @default(14)
  welcomeMessage        String?          @db.Text
  defaultBillingCurrency BillingCurrency @default(USD)
  invoicePrefix         String           @default("INV")
  invoiceGraceDays      Int              @default(14)
  autoSuspendOverdue    Boolean          @default(false)
  emailFromName         String?
  emailReplyTo          String?
  smsSenderName         String?
  maintenanceMode       Boolean          @default(false)
  maintenanceMessage    String?          @db.Text
  sessionTimeoutMinutes Int              @default(60)
  /// Public marketing / register hero background (URL or data URL).
  landingHeroImageUrl   String?          @db.Text
  /// Where schools send SaaS subscription payments (Telebirr / CBE).
  bankName              String?
  bankAccountHolder     String?
  bankAccountNumber     String?
  telebirrNumber        String?
  telebirrAccountName   String?
  payoutInstructions    String?          @db.Text
  /// Public footer / marketing social profile URLs (empty = hidden).
  socialInstagramUrl      String?
  socialFacebookUrl       String?
  socialLinkedinUrl       String?
  socialYoutubeUrl        String?
  socialTiktokUrl         String?
  socialGithubUrl         String?
  /// Editable platform role → permission keys (SUPPORT/SALES). OWNER always has all.
  rolePermissions       Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model AcademicYear {
  id        String        @id @default(cuid())
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  isCurrent Boolean       @default(false)
  schedules           FeeSchedule[]
  studentFees         StudentFee[]
  academicTerms       AcademicTerm[]
  classSubjects       ClassSubject[]
  teacherAssignments  TeacherAssignment[]
  studentEnrollments  StudentEnrollment[]
  timetable             Timetable?
  examSchedules         ExamSchedule[]
  admissionCycles       AdmissionCycle[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

model Timetable {
  id             String           @id @default(cuid())
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String           @unique
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String           @default("Main")
  isPublished    Boolean          @default(true)
  periods        TimetablePeriod[]
  rooms          TimetableRoom[]
  entries        TimetableEntry[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([schoolId])
}

model TimetablePeriod {
  id          String           @id @default(cuid())
  timetableId String
  timetable   Timetable        @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  schoolId    String
  number      Int
  label       String
  startTime   String?
  endTime     String?
  sortOrder   Int              @default(0)
  entries     TimetableEntry[]

  @@unique([timetableId, number])
  @@index([schoolId])
}

model TimetableRoom {
  id          String           @id @default(cuid())
  timetableId String
  timetable   Timetable        @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  schoolId    String
  name        String
  entries     TimetableEntry[]

  @@unique([timetableId, name])
  @@index([schoolId])
}

model TimetableEntry {
  id              String          @id @default(cuid())
  timetableId     String
  timetable       Timetable       @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  schoolId        String
  weekday         Weekday
  periodId        String
  period          TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  gradeId         String
  grade           Grade           @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  sectionId       String?
  section         Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subjectId       String
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherUserId   String?
  teacher         User?           @relation("TimetableEntryTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)
  roomId          String?
  room            TimetableRoom?  @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([timetableId, weekday, periodId, gradeId, sectionId])
  @@index([schoolId, teacherUserId, weekday])
  @@index([timetableId, gradeId, sectionId])
}

enum ExamScheduleStatus {
  DRAFT
  PUBLISHED
}

/// Mid / final exam calendar (date × grade × subjects), separate from weekly timetable.
model ExamSchedule {
  id             String             @id @default(cuid())
  schoolId       String
  school         School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  academicTermId String?
  academicTerm   AcademicTerm?      @relation(fields: [academicTermId], references: [id], onDelete: SetNull)
  title          String
  shiftLabel     String?
  notes          String?
  status         ExamScheduleStatus @default(DRAFT)
  days           ExamScheduleDay[]
  seatingPlans   ExamSeatingPlan[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([schoolId, academicYearId])
  @@index([schoolId, status])
}

model ExamScheduleDay {
  id               String            @id @default(cuid())
  scheduleId       String
  schedule         ExamSchedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  schoolId         String
  examDate         DateTime          @db.Date
  isStudyDay       Boolean           @default(false)
  studyNote        String?
  defaultStartTime String?
  defaultEndTime   String?
  sortOrder        Int               @default(0)
  slots            ExamScheduleSlot[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([scheduleId, sortOrder])
  @@index([schoolId, examDate])
}

model ExamScheduleSlot {
  id           String          @id @default(cuid())
  dayId        String
  day          ExamScheduleDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  schoolId     String
  gradeId      String
  grade        Grade           @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectLabel String
  startTime    String?
  endTime      String?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([dayId, gradeId, sortOrder])
  @@index([schoolId])
}

/// Temporary exam-hall room lists (does not change permanent class placement).
model ExamSeatingPlan {
  id             String                 @id @default(cuid())
  scheduleId     String
  schedule       ExamSchedule           @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  schoolId       String
  title          String
  notes          String?
  /// Grade IDs used when generating this plan (for re-distribute).
  sourceGradeIds String[]               @default([])
  rooms          ExamSeatingRoom[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([scheduleId])
  @@index([schoolId])
}

model ExamSeatingRoom {
  id         String                  @id @default(cuid())
  planId     String
  plan       ExamSeatingPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  schoolId   String
  name       String
  roomRef    String?
  capacity   Int                     @default(33)
  sortOrder  Int                     @default(0)
  assignments ExamSeatingAssignment[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([planId, sortOrder])
  @@index([schoolId])
}

model ExamSeatingAssignment {
  id               String         @id @default(cuid())
  roomId           String
  room             ExamSeatingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  schoolId         String
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  seatNo           Int
  /// Snapshots at generation time (stable reprints).
  studentName      String
  gradeLabel       String
  sectionLabel     String?
  createdAt        DateTime       @default(now())

  @@unique([roomId, seatNo])
  @@index([roomId])
  @@index([schoolId, studentProfileId])
}

model TeacherProfile {
  id                String              @id @default(cuid())
  userId            String              @unique
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId          String
  homeroomGradeId   String?
  homeroomGrade     Grade?              @relation("TeacherHomeroomGrade", fields: [homeroomGradeId], references: [id], onDelete: SetNull)
  homeroomSectionId String?
  homeroomSection   Section?            @relation("TeacherHomeroomSection", fields: [homeroomSectionId], references: [id], onDelete: SetNull)
  photoUrl          String?
  cardCode          String?
  assignments       TeacherAssignment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([schoolId, cardCode])
  @@index([schoolId])
  @@index([homeroomGradeId, homeroomSectionId])
}

model ClassworkAssignment {
  id              String           @id @default(cuid())
  schoolId        String
  classSubjectId  String
  classSubject    ClassSubject     @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User             @relation("ClassworkCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  title           String
  description     String?          @db.Text
  type            ClassworkType
  dueAt           DateTime?
  fileUrl         String?
  fileName        String?
  maxScore        Int              @default(100)
  status          ClassworkStatus  @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  submissions     ClassworkSubmission[]

  @@index([schoolId, classSubjectId, status])
  @@index([schoolId, createdByUserId])
}

model ClassworkSubmission {
  id               String                    @id @default(cuid())
  assignmentId     String
  assignment       ClassworkAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  status           ClassworkSubmissionStatus @default(PENDING)
  submittedAt      DateTime?
  fileUrl          String?
  fileName         String?
  note             String?                   @db.Text
  score            Int?
  feedback         String?                   @db.Text
  gradedAt         DateTime?
  gradedByUserId   String?
  gradedBy         User?                     @relation("ClassworkGradedBy", fields: [gradedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([assignmentId, studentProfileId])
  @@index([studentProfileId])
}

model TeacherAssignment {
  id               String         @id @default(cuid())
  teacherProfileId String
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  schoolId         String
  academicYearId   String?
  academicYear     AcademicYear?  @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  gradeId          String
  grade            Grade          @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  sectionId        String?
  section          Section?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subjectId        String?
  subject          Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  isHomeroom       Boolean        @default(false)
  createdAt        DateTime       @default(now())

  @@index([schoolId, gradeId])
  @@index([teacherProfileId])
}

/// Historical placement per academic year (do not overwrite when promoting).
model StudentEnrollment {
  id               String            @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile    @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  schoolId         String
  academicYearId   String
  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeId          String
  grade            Grade             @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  sectionId        String?
  section          Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  isCurrent        Boolean           @default(false)
  promotionOutcome PromotionOutcome  @default(ENROLLED)
  promotionNote    String?           @db.Text
  enrolledAt       DateTime          @default(now())

  @@unique([studentProfileId, academicYearId])
  @@index([schoolId, academicYearId, isCurrent])
}

model StudentDocument {
  id               String              @id @default(cuid())
  schoolId         String
  studentProfileId String
  studentProfile   StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  type             StudentDocumentType
  title            String?
  fileUrl          String
  uploadedById     String?
  uploadedBy       User?               @relation("StudentDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt       DateTime            @default(now())

  @@index([studentProfileId])
  @@index([schoolId, studentProfileId])
}

model BehaviorRecord {
  id               String             @id @default(cuid())
  schoolId         String
  studentProfileId String
  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  date             DateTime           @db.Date
  type             BehaviorRecordType
  note             String?            @db.Text
  recordedById     String
  recordedBy       User               @relation("BehaviorRecordedBy", fields: [recordedById], references: [id])
  createdAt        DateTime           @default(now())

  @@index([studentProfileId, date])
  @@index([schoolId, studentProfileId])
}

model StudentHealthRecord {
  id                    String         @id @default(cuid())
  studentProfileId      String         @unique
  studentProfile        StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  bloodType             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  allergies             String?        @db.Text
  medicalConditions     String?        @db.Text
  medicationNotes       String?        @db.Text
  updatedAt             DateTime       @updatedAt
}

model StudentCertificate {
  id                 String                 @id @default(cuid())
  schoolId           String
  studentProfileId   String
  studentProfile     StudentProfile         @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  type               StudentCertificateType
  certificateNumber  String
  issuedAt           DateTime               @default(now())
  issuedById         String?
  issuedBy           User?                  @relation("CertificateIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  meta               Json?

  @@index([studentProfileId])
  @@index([schoolId, certificateNumber])
}

model FeeType {
  id        String        @id @default(cuid())
  schoolId  String
  school    School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  isActive  Boolean       @default(true)
  schedules FeeSchedule[]
  studentFees StudentFee[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model FeeSchedule {
  id               String       @id @default(cuid())
  schoolId         String
  school           School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeTypeId        String
  feeType          FeeType      @relation(fields: [feeTypeId], references: [id], onDelete: Cascade)
  academicYearId   String
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  gradeId          String?
  grade            Grade?       @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  sectionId        String?
  amountCents      Int
  frequency        FeeFrequency @default(ONE_TIME)
  installmentCount Int          @default(1)
  description      String?

  @@index([schoolId, academicYearId])
  @@index([gradeId])
}

model StudentFee {
  id               String           @id @default(cuid())
  schoolId         String
  studentProfileId String
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  feeTypeId        String
  feeType          FeeType          @relation(fields: [feeTypeId], references: [id])
  academicYearId   String
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id])
  feeScheduleId    String?
  label            String
  totalAmountCents Int
  discountPercent  Int              @default(0)
  discountCents    Int              @default(0)
  amountDueCents   Int
  paidAmountCents  Int              @default(0)
  dueDate          DateTime         @db.Date
  status           StudentFeeStatus @default(PENDING)
  isScholarship    Boolean          @default(false)
  installments     FeeInstallment[]
  allocations      PaymentAllocation[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([schoolId, studentProfileId])
  @@index([schoolId, status, dueDate])
}

model FeeInstallment {
  id              String           @id @default(cuid())
  studentFeeId    String
  studentFee      StudentFee       @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  number          Int
  amountCents     Int
  dueDate         DateTime         @db.Date
  paidAmountCents Int              @default(0)
  status          StudentFeeStatus @default(PENDING)
  allocations     PaymentAllocation[]

  @@unique([studentFeeId, number])
}

model Payment {
  id               String              @id @default(cuid())
  schoolId         String
  studentProfileId String
  studentProfile   StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  receiptNumber    String              @unique
  amountCents      Int
  method           PaymentMethod
  status           PaymentStatus       @default(COMPLETED)
  reference        String?
  proofUrl         String?
  submittedBy      String?
  notes            String?
  recordedBy       String?
  recorder         User?               @relation("PaymentsRecordedBy", fields: [recordedBy], references: [id])
  paidAt           DateTime            @default(now())
  allocations      PaymentAllocation[]
  createdAt        DateTime            @default(now())

  @@index([schoolId, paidAt])
  @@index([studentProfileId])
}

model PaymentAllocation {
  id            String          @id @default(cuid())
  paymentId     String
  payment       Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  studentFeeId  String?
  studentFee    StudentFee?     @relation(fields: [studentFeeId], references: [id])
  installmentId String?
  installment   FeeInstallment? @relation(fields: [installmentId], references: [id])
  amountCents   Int

  @@index([paymentId])
  @@index([studentFeeId])
}

model LibraryCategory {
  id          String            @id @default(cuid())
  schoolId    String
  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  icon        String?
  description String?
  sortOrder   Int               @default(0)
  resources   LibraryResource[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([schoolId, slug])
  @@index([schoolId])
}

model LibraryResource {
  id                       String                  @id @default(cuid())
  schoolId                 String
  school                   School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  categoryId               String
  category                 LibraryCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title                    String
  description              String?                 @db.Text
  fileUrl                  String?
  externalUrl              String?
  coverUrl                 String?
  resourceType             LibraryResourceType
  audience                 LibraryAudience         @default(BOTH)
  subject                  String?
  gradeId                  String?
  grade                    Grade?                  @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  author                   String?
  status                   LibraryResourceStatus   @default(PUBLISHED)
  isSystem                 Boolean                 @default(false)
  platformLibraryResourceId String?
  platformLibraryResource  PlatformLibraryResource? @relation(fields: [platformLibraryResourceId], references: [id], onDelete: SetNull)
  isCustomized             Boolean                 @default(false)
  uploadedById             String?
  uploadedBy               User?                   @relation("LibraryUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  publishedAt              DateTime?
  downloadCount            Int                     @default(0)
  viewCount                Int                     @default(0)
  favorites                LibraryFavorite[]
  progress                 LibraryReadingProgress[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, categoryId])
  @@index([schoolId, gradeId])
  @@index([schoolId, resourceType])
  @@index([platformLibraryResourceId])
}

model LibraryFavorite {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  resourceId       String
  resource         LibraryResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([studentProfileId, resourceId])
  @@index([studentProfileId])
}

model LibraryReadingProgress {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  resourceId       String
  resource         LibraryResource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  progressPercent  Int            @default(0)
  lastReadPage     Int?
  lastOpenedAt     DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([studentProfileId, resourceId])
  @@index([studentProfileId])
}

// ── Platform content layer ──

enum ProvisioningStepStatus {
  SUCCESS
  SKIPPED
  FAILED
}

model PlatformSubject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  icon        String?
  curriculum  String?
  level       String?
  gradeMin    Int?
  gradeMax    Int?
  isArchived  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packageLinks   CurriculumPackageSubject[]
  schoolSubjects Subject[]
}

model PlatformAcademicStructure {
  id          String      @id @default(cuid())
  key         String      @unique
  label       String
  description String?     @db.Text
  gradePreset GradePreset
  isArchived  Boolean     @default(false)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  packages CurriculumPackage[]
}

model PlatformLibraryCategory {
  id          String                  @id @default(cuid())
  slug        String                  @unique
  name        String
  icon        String?
  description String?
  sortOrder   Int                     @default(0)
  resources   PlatformLibraryResource[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
}

model PlatformLibraryResource {
  id           String                  @id @default(cuid())
  categoryId   String
  category     PlatformLibraryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title        String
  description  String?                 @db.Text
  fileUrl      String?
  externalUrl  String?
  coverUrl     String?
  resourceType LibraryResourceType
  audience     LibraryAudience         @default(BOTH)
  subject      String?
  gradeLabel   String?
  isArchived   Boolean                 @default(false)
  sortOrder    Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  packageLinks    CurriculumPackageLibraryItem[]
  schoolResources LibraryResource[]
}

model PlatformMessageTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  channel     String
  body        String   @db.Text
  description String?  @db.Text
  isArchived  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packageLinks   CurriculumPackageTemplate[]
  schoolTemplates SchoolMessageTemplate[]
}

model PlatformAssessmentTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.Text
  gradeMin    Int?
  gradeMax    Int?
  isArchived  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  components     PlatformAssessmentTemplateComponent[]
  packageLinks   CurriculumPackageAssessmentTemplate[]
  schoolTemplates AssessmentTemplate[]
}

model PlatformAssessmentTemplateComponent {
  id            String                     @id @default(cuid())
  templateId    String
  template      PlatformAssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name          String
  weightPercent Int
  maxScore      Int                        @default(100)
  sortOrder     Int                        @default(0)

  @@unique([templateId, name])
}

model SchoolProvisioningLog {
  id         String                 @id @default(cuid())
  schoolId   String
  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  packageKey String?
  step       String
  status     ProvisioningStepStatus
  message    String?                @db.Text
  meta       Json?
  createdAt  DateTime               @default(now())

  @@index([schoolId, createdAt])
}

// ── Platform curriculum catalog (master presets) ──

model CurriculumPackage {
  id                  String   @id @default(cuid())
  key                 String   @unique
  label               String
  description         String?  @db.Text
  gradePreset         GradePreset?
  schoolType          SchoolType?
  academicStructureId String?
  academicStructure   PlatformAcademicStructure? @relation(fields: [academicStructureId], references: [id], onDelete: SetNull)
  isActive            Boolean  @default(true)
  isBlank             Boolean  @default(false)
  sortOrder           Int      @default(0)
  subjects            CurriculumPackageSubject[]
  departments         CurriculumPackageDepartment[]
  libraryItems        CurriculumPackageLibraryItem[]
  templates           CurriculumPackageTemplate[]
  assessmentTemplates CurriculumPackageAssessmentTemplate[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CurriculumPackageSubject {
  id                String            @id @default(cuid())
  packageId         String
  package           CurriculumPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  platformSubjectId String?
  platformSubject   PlatformSubject?  @relation(fields: [platformSubjectId], references: [id], onDelete: SetNull)
  code              String
  name              String
  level             String?
  sortOrder         Int               @default(0)

  @@unique([packageId, code])
  @@index([packageId])
  @@index([platformSubjectId])
}

model CurriculumPackageDepartment {
  id        String            @id @default(cuid())
  packageId String
  package   CurriculumPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int               @default(0)

  @@unique([packageId, name])
}

model CurriculumPackageLibraryItem {
  id                       String                   @id @default(cuid())
  packageId                String
  package                  CurriculumPackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  platformLibraryResourceId String?
  platformLibraryResource  PlatformLibraryResource? @relation(fields: [platformLibraryResourceId], references: [id], onDelete: SetNull)
  title                    String
  description              String?                  @db.Text
  resourceType             LibraryResourceType
  categorySlug             String
  subject                  String?
  gradeLabel               String?
  sortOrder                Int                      @default(0)

  @@index([packageId])
  @@index([platformLibraryResourceId])
}

model CurriculumPackageTemplate {
  id                        String                   @id @default(cuid())
  packageId                 String
  package                   CurriculumPackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  platformMessageTemplateId String?
  platformMessageTemplate   PlatformMessageTemplate? @relation(fields: [platformMessageTemplateId], references: [id], onDelete: SetNull)
  key                       String
  name                      String
  channel                   String
  body                      String                   @db.Text
  sortOrder                 Int                      @default(0)

  @@unique([packageId, key])
  @@index([platformMessageTemplateId])
}

model CurriculumPackageAssessmentTemplate {
  id                           String                     @id @default(cuid())
  packageId                    String
  package                      CurriculumPackage          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  platformAssessmentTemplateId String
  platformAssessmentTemplate   PlatformAssessmentTemplate @relation(fields: [platformAssessmentTemplateId], references: [id], onDelete: Cascade)
  sortOrder                    Int                        @default(0)

  @@unique([packageId, platformAssessmentTemplateId])
  @@index([packageId])
}

model SchoolDepartment {
  id        String @id @default(cuid())
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0)

  @@unique([schoolId, name])
  @@index([schoolId])
}

model SchoolMessageTemplate {
  id                        String                   @id @default(cuid())
  schoolId                  String
  school                    School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key                       String
  name                      String
  channel                   String
  body                      String                   @db.Text
  isSystem                  Boolean                  @default(false)
  platformMessageTemplateId String?
  platformMessageTemplate   PlatformMessageTemplate? @relation(fields: [platformMessageTemplateId], references: [id], onDelete: SetNull)
  isCustomized              Boolean                  @default(false)

  @@unique([schoolId, key])
  @@index([schoolId])
  @@index([platformMessageTemplateId])
}

// ── Admissions (applicant pipeline → score placement → enroll) ──

model AdmissionCycle {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  isOpen         Boolean  @default(true)
  /// Place applicant as soon as entrance/interview score is saved.
  autoPlaceOnScore   Boolean @default(true)
  /// Skip manual Accept — mark ACCEPTED right after placement.
  autoAcceptOnPlace  Boolean @default(true)
  /// Enroll into student roster when placement completes (requires ID, gender, DOB).
  autoEnrollOnPlace  Boolean @default(false)
  createdAt      DateTime @default(now())
  applications   AdmissionApplication[]
  placementRules AdmissionPlacementRule[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, isOpen])
}

model AdmissionApplication {
  id                String           @id @default(cuid())
  schoolId          String
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycleId           String
  cycle             AdmissionCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  status            AdmissionStatus  @default(APPLIED)
  firstName         String
  lastName          String
  middleName        String?
  gender            Gender?
  dateOfBirth       DateTime?
  idNumber          String?
  phone             String?
  fatherName        String
  fatherPhone       String
  motherName        String
  motherPhone       String
  email             String?
  targetGradeId     String?
  targetGrade       Grade?           @relation("ApplicationTargetGrade", fields: [targetGradeId], references: [id], onDelete: SetNull)
  entranceScore     Int?
  interviewScore    Int?
  totalScore        Int?
  placedGradeId     String?
  placedGrade       Grade?           @relation("ApplicationPlacedGrade", fields: [placedGradeId], references: [id], onDelete: SetNull)
  placedSectionId   String?
  placedSection     Section?         @relation(fields: [placedSectionId], references: [id], onDelete: SetNull)
  placementRuleId   String?
  placementRule     AdmissionPlacementRule? @relation(fields: [placementRuleId], references: [id], onDelete: SetNull)
  placementNote     String?
  enrolledProfileId String?          @unique
  enrolledProfile   StudentProfile?  @relation(fields: [enrolledProfileId], references: [id], onDelete: SetNull)
  appliedAt         DateTime         @default(now())
  placedAt          DateTime?
  enrolledAt        DateTime?
  notes             String?          @db.Text

  @@index([schoolId, cycleId, status])
  @@index([schoolId, totalScore])
}

model AdmissionPlacementRule {
  id              String         @id @default(cuid())
  schoolId        String
  school          School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycleId         String
  cycle           AdmissionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  label           String
  minScore        Int
  maxScore        Int
  targetGradeId   String
  targetGrade     Grade          @relation(fields: [targetGradeId], references: [id], onDelete: Cascade)
  targetSectionId String?
  targetSection   Section?       @relation(fields: [targetSectionId], references: [id], onDelete: SetNull)
  /// When set (e.g. "Natural", "Social"), auto-pick least-filled matching section in the grade.
  streamMatch     String?
  sortOrder       Int            @default(0)
  isActive        Boolean        @default(true)
  applications    AdmissionApplication[]

  @@index([cycleId, sortOrder])
}
